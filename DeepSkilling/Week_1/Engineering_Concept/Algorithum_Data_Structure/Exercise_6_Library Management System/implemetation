
public class FinancialForecasting {

    public static double calculateFutureValueRecursive(double currentValue, double growthRate, int years) {
        if (years == 0) {
            return currentValue;
        }
        return calculateFutureValueRecursive(currentValue * (1 + growthRate), growthRate, years - 1);
    }

    public static double calculateFutureValueOptimized(double currentValue, double growthRate, int years, double[] memo) {
        if (years == 0) {
            return currentValue;
        }
        if (memo[years] != 0) {
            return memo[years];
        }
        memo[years] = calculateFutureValueOptimized(currentValue * (1 + growthRate), growthRate, years - 1, memo);
        return memo[years];
    }
}